{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noResolve": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": { "#cl/*": ["./*"] }
  },
  "include": ["app.js", "src/*.js", "types/page.d.ts", "types/qrcodegen.d.ts", "types/stamps.d.ts"],
  "exclude": ["src/qr-worker.js", "src/worker-lockdown.js", "src/qr-decode.js"]
}
