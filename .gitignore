# Local and generated files that must never be published.
node_modules/
__pycache__/
*.pyc
*.bak*
.DS_Store
# Signing material and machine-local Android files, wherever they land in the repo.
# android/.gitignore covers the Gradle tree; these catch a key dropped anywhere else.
*.p12
*.jks
*.keystore
keystore.properties
local.properties
# zsp (the Zapstore publisher) offers to save SIGN_WITH, the publishing key, into .env in the
# repository root. It must never be committed (as in MoonApp, SunApp and UsernameGenerator).
.env
.env.*
!.env.example
