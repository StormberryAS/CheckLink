<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground for CheckLink (ICON-1 A, "A closer look"), drawn from the web
  app's favicon.svg (64 x 64) by android/tools/make_icons.py. The mark is scaled and
  centred on its own bounding box so that every point of it stays inside the 66 unit
  safe zone that launchers never crop. Edit favicon.svg and the script, not this file.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.8487"
        android:scaleY="0.8487"
        android:translateX="25.99"
        android:translateY="25.99">
        <!-- favicon.svg, shape for shape, in its order: the handle, then the lens over its
             inner end, then the link under the glass. -->
        <path
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:pathData="M43,43 L56,56">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="42" android:startY="42" android:endX="59" android:endY="59">
                    <item android:offset="0" android:color="#FFE879F9" />
                    <item android:offset="1" android:color="#FF9333EA" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#FF1B1226"
            android:strokeWidth="5"
            android:pathData="M8.5,28 A19.5,19.5 0 1,0 47.5,28 A19.5,19.5 0 1,0 8.5,28 Z">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="8" android:startY="8" android:endX="48" android:endY="48">
                    <item android:offset="0" android:color="#FFF0ABFC" />
                    <item android:offset="1" android:color="#FFA855F7" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M24,22 H20 A6,6 0 0,0 20,34 H24 M32,22 H36 A6,6 0 0,1 36,34 H32 M24,28 H32">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="12" android:startY="20" android:endX="44" android:endY="36">
                    <item android:offset="0" android:color="#FFFFFFFF" />
                    <item android:offset="1" android:color="#FFF0ABFC" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
